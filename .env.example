# API Configuration
# Production backend is on Contabo (pm2 process "lejerli"), not Vercel —
# Vercel's serverless functions can't hold the persistent socket.io
# connections chat needs. Leave this unset locally and the app already
# defaults to https://piperpoloter.online (see services/api.ts).
EXPO_PUBLIC_API_URL=https://piperpoloter.online

# App Configuration
APP_NAME=Lejerli
APP_VERSION=1.0.0

# Environment
NODE_ENV=development
